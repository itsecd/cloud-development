{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cache": {
    "ExpirationMinutes": 5
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:7201",
      "https://localhost:7202"
    ]
  },
  "LocalStack": {
    "UseLocalStack": true,
    "Config": {
      "LocalStackHost": "localhost",
      "EdgePort": 14566,
      "UseSsl": false
    }
  },
  "AWS": {
    "Resources": {
      "SQSQueueName": "vehicle-queue"
    }
  }
}