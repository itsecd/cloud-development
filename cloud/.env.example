# Идентификатор облака. Получить: yc config get cloud-id
YC_CLOUD_ID="b1g..."

# Идентификатор каталога. Получить: yc config get folder-id
YC_FOLDER_ID="b1g..."

# Регион Yandex Cloud для Object Storage, Message Queue и Cloud Functions.
# Обычно используется ru-central1.
YC_REGION="ru-central1"

# Имя сервисного аккаунта, под которым будут работать API Gateway, функции и триггер.
# Можно выбрать любое уникальное имя в каталоге, например employee-contracts-sa.
YC_SERVICE_ACCOUNT_NAME="employee-contracts-sa"

# Статический ключ сервисного аккаунта для S3/YMQ-compatible API.
# Получить после создания сервисного аккаунта:
# SA_ID=$(yc iam service-account get "$YC_SERVICE_ACCOUNT_NAME" --folder-id "$YC_FOLDER_ID" --format json | python3 -c "import json,sys; print(json.load(sys.stdin)['id'])")
# yc iam access-key create --service-account-id "$SA_ID" --folder-id "$YC_FOLDER_ID"
YC_STATIC_KEY_ID="YCAJ..."

# Секретная часть статического ключа из команды yc iam access-key create.
# Показывается один раз, храните только в cloud/.env или другом секретном хранилище.
YC_STATIC_KEY_SECRET="..."

# Уникальное имя публичного бакета Object Storage для Blazor WASM клиента.
# Имя бакета должно быть глобально уникальным в Yandex Object Storage.
YC_CLIENT_BUCKET="employee-contracts-client"

# Уникальное имя приватного бакета Object Storage для JSON-файлов сотрудников.
YC_FILES_BUCKET="employee-contracts-files"

# Имя очереди Yandex Message Queue для передачи сотрудников в файловую функцию.
YC_QUEUE_NAME="employee-contracts-queue"

# Имя Cloud Function, которая генерирует сотрудников и публикует сообщения в YMQ.
YC_API_FUNCTION_NAME="employee-contracts-api"

# Имя Cloud Function, которую вызывает YMQ-trigger для сохранения JSON в Object Storage.
YC_FILE_FUNCTION_NAME="employee-contracts-file-worker"

# Имя Cloud Function для HTTP-доступа к списку файлов и файлу по id.
YC_FILE_HTTP_FUNCTION_NAME="employee-contracts-file-http"

# Имя Yandex API Gateway, который публикует HTTP API наружу.
YC_API_GATEWAY_NAME="employee-contracts-gateway"

# Необязательное имя YMQ-trigger. Если не задано, deploy.sh использует имя на основе файловой функции.
# YC_QUEUE_TRIGGER_NAME="employee-contracts-file-trigger"
